{
  "nodeModulesDir": "auto",
  "permissions": {
    "default": {
      "env": ["PORT", "HOST", "CONSOLA_LEVEL"],
      "net": ["0.0.0.0", "127.0.0.1"]
    }
  },
  "tasks": {
    "start": "deno run --no-prompt -P index.js",
    "check": "deno check index.js",
    "format": "oxfmt \"**/*.{js,json,md}\"",
    "typecheck": "oxlint --type-aware"
  }
}
