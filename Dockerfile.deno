FROM denoland/deno:alpine-2.9.4

WORKDIR /app

COPY deno.json deno.lock package.json ./
COPY index.js ./
RUN deno cache --frozen index.js

COPY --chown=root:root . .

USER deno

EXPOSE 3000

ENV NODE_ENV=production
ENV HOST=0.0.0.0

HEALTHCHECK CMD wget -qO- http://127.0.0.1:3000/health || exit 1

CMD ["deno", "task", "start"]
